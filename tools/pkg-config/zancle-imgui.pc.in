prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@ZA_RELATIVE_INSTALL_LIBDIR@
includedir=${prefix}/include

Name: Zancle-imgui
Description: Zancle, an opinionated fork of SFML, imgui module.
URL: https://github.com/vittorioromeo/Zancle
Version: @PROJECT_VERSION@
Requires: zancle-graphics
Libs: -L${libdir} -lzancle-imgui
# gl may not be in pkg-config
Libs.private: @OPENGL_gl_LIBRARY@ @OPENGL_glu_LIBRARY@
Cflags: -I${includedir}

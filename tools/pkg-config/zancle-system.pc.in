prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@ZA_RELATIVE_INSTALL_LIBDIR@
includedir=${prefix}/include

Name: Zancle-system
Description: Zancle, an opinionated fork of SFML, system module.
URL: https://github.com/vittorioromeo/Zancle
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lzancle-system
Cflags: -I${includedir}

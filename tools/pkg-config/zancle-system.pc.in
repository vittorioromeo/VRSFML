prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@ZA_RELATIVE_INSTALL_LIBDIR@
includedir=${prefix}/include

Name: SFML-system
Description: The Simple and Fast Multimedia Library, system module.
URL: http://www.zancle-dev.org
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lzancle-system
Cflags: -I${includedir}

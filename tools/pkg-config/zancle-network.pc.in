prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@ZA_RELATIVE_INSTALL_LIBDIR@
includedir=${prefix}/include

Name: Zancle-network
Description: Zancle, an opinionated fork of SFML, network module.
URL: https://github.com/vittorioromeo/Zancle
Version: @PROJECT_VERSION@
Requires: zancle-system
Libs: -L${libdir} -lzancle-network
Cflags: -I${includedir}

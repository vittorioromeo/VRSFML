prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@ZA_RELATIVE_INSTALL_LIBDIR@
includedir=${prefix}/include

Name: Zancle-graphics
Description: Zancle, an opinionated fork of SFML, graphics module.
URL: https://github.com/vittorioromeo/Zancle
Version: @PROJECT_VERSION@
Requires: zancle-window
Requires.private: zancle-system, freetype2
Libs: -L${libdir} -lzancle-graphics
# gl may not be in pkg-config
Libs.private: @OPENGL_gl_LIBRARY@ @OPENGL_glu_LIBRARY@
Cflags: -I${includedir}

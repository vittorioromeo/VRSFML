prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@ZA_RELATIVE_INSTALL_LIBDIR@
includedir=${prefix}/include

Name: SFML-audio
Description: The Simple and Fast Multimedia Library, audio module.
URL: http://www.zancle-dev.org
Version: @PROJECT_VERSION@
Requires: zancle-system
Requires.private: vorbisenc, vorbisfile, vorbis, ogg, flac
Libs: -L${libdir} -lzancle-audio
Cflags: -I${includedir}

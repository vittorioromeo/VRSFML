prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@ZA_RELATIVE_INSTALL_LIBDIR@
includedir=${prefix}/include

Name: Zancle-audio
Description: Zancle, an opinionated fork of SFML, audio module.
URL: https://github.com/vittorioromeo/Zancle
Version: @PROJECT_VERSION@
Requires: zancle-system
Requires.private: vorbisenc, vorbisfile, vorbis, ogg, flac
Libs: -L${libdir} -lzancle-audio
Cflags: -I${includedir}

list(APPEND CMAKE_MODULE_PATH ${CMAKE_CURRENT_LIST_DIR})

include(CMakeFindDependencyMacro)

# When installing, save whether Zancle was built using system dependencies.
set(ZA_BUILT_USING_SYSTEM_DEPS @ZA_USE_SYSTEM_DEPS@)

# start with an empty list
set(FIND_ZANCLE_DEPENDENCIES_NOTFOUND)

if(ZA_BUILT_USING_SYSTEM_DEPS)
    find_dependency(MbedTLS)
else()
    find_dependency(MbedTLS CONFIG PATHS "${CMAKE_CURRENT_LIST_DIR}/../../../" NO_DEFAULT_PATH)
endif()

if(FIND_ZANCLE_DEPENDENCIES_NOTFOUND)
    set(FIND_ZANCLE_ERROR "Zancle found but some of its dependencies are missing (${FIND_ZANCLE_DEPENDENCIES_NOTFOUND})")
    set(ZA_FOUND OFF)
endif()

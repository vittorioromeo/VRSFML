list(APPEND CMAKE_MODULE_PATH ${CMAKE_CURRENT_LIST_DIR})

include(CMakeFindDependencyMacro)

# detect the OS
if(${CMAKE_SYSTEM_NAME} MATCHES "Windows")
    set(FIND_ZANCLE_OS_WINDOWS 1)
elseif(${CMAKE_SYSTEM_NAME} MATCHES "Linux")
    set(FIND_ZANCLE_OS_LINUX 1)

    if(@ZA_USE_DRM@)
        set(FIND_ZANCLE_USE_DRM 1)
    endif()
elseif(${CMAKE_SYSTEM_NAME} MATCHES "FreeBSD")
    set(FIND_ZANCLE_OS_FREEBSD 1)
elseif(${CMAKE_SYSTEM_NAME} MATCHES "OpenBSD")
    set(FIND_ZANCLE_OS_OPENBSD 1)
elseif(${CMAKE_SYSTEM_NAME} MATCHES "Android")
    set(FIND_ZANCLE_OS_ANDROID 1)
elseif(${CMAKE_SYSTEM_NAME} MATCHES "iOS")
    set(FIND_ZANCLE_OS_IOS 1)
elseif(${CMAKE_SYSTEM_NAME} MATCHES "Darwin")
    set(FIND_ZANCLE_OS_MACOS 1)
endif()

# start with an empty list
set(FIND_ZANCLE_DEPENDENCIES_NOTFOUND)

if(FIND_ZANCLE_USE_DRM)
    find_dependency(DRM)
    find_dependency(GBM)
endif()

if(FIND_ZANCLE_OS_LINUX)
    find_dependency(UDev)
endif()

if(NOT FIND_ZANCLE_OS_ANDROID AND NOT FIND_ZANCLE_OS_IOS)
    find_dependency(OpenGL COMPONENTS OpenGL)
endif()

find_dependency(EGL)
find_dependency(GLES)

if(FIND_ZANCLE_DEPENDENCIES_NOTFOUND)
    set(FIND_ZANCLE_ERROR "Zancle found but some of its dependencies are missing (${FIND_ZANCLE_DEPENDENCIES_NOTFOUND})")
    set(ZA_FOUND OFF)
endif()

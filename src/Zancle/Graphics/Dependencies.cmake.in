list(APPEND CMAKE_MODULE_PATH ${CMAKE_CURRENT_LIST_DIR})

include(CMakeFindDependencyMacro)

# When installing, save whether Zancle was built using system dependencies.
set(ZA_BUILT_USING_SYSTEM_DEPS @ZA_USE_SYSTEM_DEPS@)

# start with an empty list
set(FIND_SFML_DEPENDENCIES_NOTFOUND)

if(ZA_BUILT_USING_SYSTEM_DEPS)
    find_dependency(Freetype)
    find_dependency(ImGui)
else()
    find_dependency(Freetype CONFIG PATHS "${CMAKE_CURRENT_LIST_DIR}/../../../")
    find_dependency(ImGui CONFIG PATHS "${CMAKE_CURRENT_LIST_DIR}/../../../")
endif()

if(FIND_SFML_DEPENDENCIES_NOTFOUND)
    set(FIND_SFML_ERROR "Zancle found but some of its dependencies are missing (${FIND_SFML_DEPENDENCIES_NOTFOUND})")
    set(ZA_FOUND OFF)
endif()

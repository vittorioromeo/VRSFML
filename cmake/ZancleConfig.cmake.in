# This script provides the Zancle libraries as imported targets
# ------------------------------------
#
# Usage
# -----
#
# When you try to locate the Zancle libraries, you must specify which modules you want to use (System, Window, Graphics, Network, Audio, Main).
# If none is given, no imported target will be created and you won't be able to link to Zancle libraries.
# example:
#   find_package(Zancle COMPONENTS Graphics Window System) # find the graphics, window and system modules
#
# You can enforce a specific version, either MAJOR.MINOR or only MAJOR.
# If nothing is specified, the version won't be checked (i.e. any version will be accepted).
# example:
#   find_package(Zancle COMPONENTS ...)     # no specific version required
#   find_package(Zancle 3 COMPONENTS ...)   # any 3.x version
#   find_package(Zancle 3.0.1 COMPONENTS ...) # version 3.0.1 or greater with the same major version
#
# By default, the dynamic libraries of Zancle will be found. To find the static ones instead,
# you must set the ZA_STATIC_LIBRARIES variable to ON before calling find_package(Zancle ...).
# You don't need to deal with Zancle's dependencies when linking your targets against Zancle libraries,
# they will all be configured automatically, even if you use Zancle static libraries.
# example:
#   set(ZA_STATIC_LIBRARIES ON)
#   find_package(Zancle 3 COMPONENTS Network System)
#
# When searching for Zancle with find_package(), keep in mind that it will also find versions which are
# in development (i.e. between two released versions), if you have them in your search path.
# If you want to make sure that a found Zancle package corresponds to an official release, check the
# bool output variable ZA_VERSION_IS_RELEASE, which is true for official releases and false for development versions.
#
# On macOS by default CMake will search for frameworks. If you want to use static libraries and have installed
# both Zancle frameworks and Zancle static libraries, your must set CMAKE_FIND_FRAMEWORK to "NEVER" or "LAST"
# in addition to setting ZA_STATIC_LIBRARIES to ON. Otherwise CMake will check the frameworks bundle config and
# fail after finding out that it does not provide static libraries. Please refer to CMake documentation for more details.
#
# Additionally, keep in mind that Zancle frameworks are only available as release libraries unlike dylibs which
# are available for both release and debug modes.
#
# If Zancle is not installed in a standard path, you can use CMAKE_PREFIX_PATH to tell CMake in what directory
# Zancle was installed.
#
# Output
# ------
#
# This script defines the following variables:
# - For each specified module XXX (System, Window, Graphics, Network, Audio, Main):
#   - ZA_XXX_FOUND:  true if either the debug or release library of the xxx module is found
# - ZA_FOUND:        true if all the required modules are found
#
# And the following targets:
# - For each specified module XXX (System, Window, Graphics, Network, Audio, Main):
#   - Zancle::XXX
# The Zancle targets are the same for both Debug and Release build configurations and will automatically provide
# correct settings based on your currently active build configuration. The Zancle targets name also do not change
# when using dynamic or static Zancle libraries.
#
# When linking against a Zancle target, you do not need to specify indirect dependencies. For example, linking
# against Zancle::Graphics will also automatically link against Zancle::Window and Zancle::System.
#
# example:
#   find_package(Zancle 3 COMPONENTS Graphics Audio REQUIRED)
#   add_executable(myapp ...)
#   target_link_libraries(myapp PRIVATE Zancle::Graphics Zancle::Audio)

cmake_policy(VERSION 3.22...3.31)

if(NOT ZA_FIND_COMPONENTS)
    message(FATAL_ERROR "find_package(Zancle) called with no component")
endif()

set(ZA_SUPPORTED_COMPONENTS Audio Graphics Main Network System Window)

foreach(component ${ZA_FIND_COMPONENTS})
    if(NOT component IN_LIST ZA_SUPPORTED_COMPONENTS)
        set(ZA_FOUND OFF)
        set(ZA_NOT_FOUND_MESSAGE "Unsupported Zancle component: ${component}")
        message(FATAL_ERROR "${ZA_NOT_FOUND_MESSAGE}")
    endif()
endforeach()

set(FIND_SFML_PATHS
    "${CMAKE_CURRENT_LIST_DIR}/../../.."
    ~/Library/Frameworks
    /Library/Frameworks
    /usr/local
    /usr
    /sw
    /opt/local
    /opt/csw
    /opt)

find_path(ZA_DOC_DIR Zancle.tag
          PATH_SUFFIXES Zancle/doc share/doc/Zancle
          PATHS ${FIND_SFML_PATHS})

# Update requested components (eg. request window component if graphics component was requested)
set(FIND_SFML_COMPONENTS_SORTED "")
if("Audio" IN_LIST ZA_FIND_COMPONENTS)
    list(APPEND FIND_SFML_COMPONENTS_SORTED "System" "Audio")
endif()
if("Graphics" IN_LIST ZA_FIND_COMPONENTS)
    list(APPEND FIND_SFML_COMPONENTS_SORTED "System" "Window" "Graphics")
endif()
if("Main" IN_LIST ZA_FIND_COMPONENTS)
    list(APPEND FIND_SFML_COMPONENTS_SORTED "Main")
endif()
if("Network" IN_LIST ZA_FIND_COMPONENTS)
    list(APPEND FIND_SFML_COMPONENTS_SORTED "System" "Network")
endif()
if("System" IN_LIST ZA_FIND_COMPONENTS)
    list(APPEND FIND_SFML_COMPONENTS_SORTED "System")
endif()
if("Window" IN_LIST ZA_FIND_COMPONENTS)
    list(APPEND FIND_SFML_COMPONENTS_SORTED "System" "Window")
endif()
list(REMOVE_DUPLICATES FIND_SFML_COMPONENTS_SORTED)

# Choose which target definitions must be imported
if(ZA_STATIC_LIBRARIES)
    set(ZA_IS_FRAMEWORK_INSTALL "@ZA_BUILD_FRAMEWORKS@")
    if(ZA_IS_FRAMEWORK_INSTALL)
        message(WARNING "Static frameworks are not supported by Zancle. Clear cache entries, \
and either change ZA_STATIC_LIBRARIES or CMAKE_FIND_FRAMEWORK before calling find_package(Zancle)")
    endif()
    set(config_name "Static")
else()
    set(config_name "Shared")
endif()

# Set ZA_FOUND to ON by default, may be overwritten by one of the includes below
set(ZA_FOUND ON)

# Only configure dependencies if we are static linking
if(ZA_STATIC_LIBRARIES)
    # Look for dependencies in "reverse order"
    # This is due to the fact that among other things, resolving the
    # X11 dependency will break our own find_package(Freetype CONFIG)
    # because X11 attempts to find Freetype itself to resolve its Xft dependency.
    set(FIND_SFML_COMPONENTS_REVERSED ${FIND_SFML_COMPONENTS_SORTED})
    list(REVERSE FIND_SFML_COMPONENTS_REVERSED)

    foreach(component ${FIND_SFML_COMPONENTS_REVERSED})
        set(dependencies_file "${CMAKE_CURRENT_LIST_DIR}/Zancle${component}Dependencies.cmake")
        if(EXISTS "${dependencies_file}")
            include("${dependencies_file}")
        endif()
    endforeach()
endif()

foreach(component ${FIND_SFML_COMPONENTS_SORTED})
    string(TOUPPER "${component}" UPPER_COMPONENT)
    set(targets_config_file "${CMAKE_CURRENT_LIST_DIR}/Zancle${component}${config_name}Targets.cmake")

    # Generate imported targets for Zancle components
    if(EXISTS "${targets_config_file}")
        include("${targets_config_file}")

        if(TARGET Zancle::${component})
            set(ZA_${UPPER_COMPONENT}_FOUND ON)
        else()
            set(ZA_${UPPER_COMPONENT}_FOUND OFF)
            set(ZA_FOUND OFF)
            if(ZA_FIND_REQUIRED_${component})
                set(FIND_SFML_ERROR "Found Zancle but requested component '${component}' is missing in the package configuration.")
            endif()
        endif()
    else()
        set(FIND_SFML_ERROR "Requested Zancle configuration (${config_name}) was not found")
        if(config_name STREQUAL "Shared")
            string(APPEND FIND_SFML_ERROR "\nSet ZA_STATIC_LIBRARIES to ON for static libraries")
        elseif(config_name STREQUAL "Static")
            string(APPEND FIND_SFML_ERROR "\nSet ZA_STATIC_LIBRARIES to OFF for shared libraries")
        endif()
        set(ZA_${UPPER_COMPONENT}_FOUND OFF)
        set(ZA_FOUND OFF)
    endif()
endforeach()

if(ZA_FOUND)
    set(ZA_VERSION_IS_RELEASE @VERSION_IS_RELEASE@)
else()
    if(ZA_FIND_REQUIRED)
        # fatal error
        message(FATAL_ERROR "${FIND_SFML_ERROR}")
    elseif(NOT ZA_FIND_QUIETLY)
        # error but continue
        message(STATUS "${FIND_SFML_ERROR}")
    endif()
endif()

if(ZA_FOUND AND NOT ZA_FIND_QUIETLY)
    message(STATUS "Found Zancle @PROJECT_VERSION@ in ${CMAKE_CURRENT_LIST_DIR}")
endif()
